# Konfigurasi backend Supabase (repo Bajoel32/srikandi-backend) untuk
# pengembangan lokal. Salin ke .env.local dan isi bila ingin menyambung ke
# backend sungguhan -- kosongkan (atau hapus filenya) untuk memakai data
# statis/dummy bawaan tiap fitur.
#
# PENTING: VITE_ORDERS_API adalah base URL (TANPA akhiran path) -- kode di
# src/config/orders.js menambahkan sendiri /auth/login dan /my-orders. Tiga
# variabel lainnya adalah URL PENUH ke masing-masing endpoint.

VITE_GALLERY_API=https://ojmxxuzgjdslcwvwyzbo.supabase.co/functions/v1/api/gallery
VITE_BOOKINGS_API=https://ojmxxuzgjdslcwvwyzbo.supabase.co/functions/v1/api/bookings
VITE_CONSULT_API=https://ojmxxuzgjdslcwvwyzbo.supabase.co/functions/v1/api/consult
VITE_ORDERS_API=https://ojmxxuzgjdslcwvwyzbo.supabase.co/functions/v1/api
