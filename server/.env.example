# Salin ke server/.env lalu sesuaikan.

PORT=8787
NODE_ENV=development

# CORS — origin frontend yang boleh memanggil API (pisahkan koma).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Origin admin hub (app terpisah). Digabung ke allowlist CORS.
ADMIN_ORIGINS=http://localhost:5174

# Masa berlaku token sesi konsumen (detik). 86400 = 24 jam.
SESSION_TTL=86400

# Enkripsi data pelanggan at-rest (AES-256-GCM): koleksi customers, orders,
# bookings, sessions, consult_logs. Kosong -> data disimpan polos.
# Buat kunci (32-byte base64):  npm run gen:datakey
DATA_ENCRYPTION_KEY=
# Kunci LAMA — isi HANYA saat rotasi kunci, lalu jalankan:
#   npm run rotate:datakey   (mendekripsi data lama, menulis ulang dengan kunci baru)
# Setelah sukses, kosongkan lagi.
DATA_ENCRYPTION_KEY_OLD=

# Retensi PII: field `ip` di bookings & consult_logs dibuang setelah N hari. 0 = mati.
DATA_RETENTION_DAYS=90

# --- Database ---
# Kosong  -> penyimpanan file JSON di server/data/ (dev lokal).
# Diisi    -> Postgres (mis. Neon). WAJIB diisi di Render (disk-nya ephemeral).
# Contoh Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Admin hub ---
# ADMIN_PASSWORD_HASH dibuat dengan:  npm run admin:hash -- "kata-sandi-anda"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$IeBXcmd8.QG5vNf3r7gDW.9BnRYlR1ARKtAKC7Hc2IocSx./dB0Wq
ADMIN_SESSION_TTL=43200

# Anthropic (opsional). Kosong -> /api/consult pakai fallback kata kunci lokal.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Plafon panggilan Claude /api/consult per hari (lindungi tagihan API). Lewat
# batas -> semua konsultasi turun ke fallback kata kunci sampai ganti hari.
CONSULT_DAILY_LLM_BUDGET=300

# Deep-link WhatsApp untuk eskalasi ke admin.
WHATSAPP_BASE=https://wa.me/6281234567890
