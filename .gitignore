node_modules/
jspm_packages/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ---- Logs ----
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ---- Environment / rahasia (JANGAN di-commit) ----
.env
.env.*
!.env.example
!.env.*.example
*.local

# ---- Build output ----
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# ---- Cache & coverage ----
.cache/
.npm
.eslintcache
.stylelintcache
coverage/
*.lcov
.nyc_output/
.parcel-cache/

# ---- Editor / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Backend (server/) — data lokal, jangan dipublikasikan ----
server/data/*.json
